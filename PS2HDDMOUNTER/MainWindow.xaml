<Window x:Class="PS2HDDMOUNTER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PS2HDDMOUNTER"
        mc:Ignorable="d"
        Title="PS2 HDD MOUNTER // PFS EXPLORER" Height="680" Width="840"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <DropShadowEffect x:Key="CyanGlow" Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
        <Style x:Key="SciFiButton" TargetType="Button">
            <Setter Property="Background" Value="#121B33"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Custom Sci-Fi ComboBox (2026 HUD Theme) -->
        <Style x:Key="SciFiComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#090E1C"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#14223D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="#090E1C" BorderBrush="#00F0FF" BorderThickness="1.2" CornerRadius="3" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#00F0FF"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E315C"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#14223D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#090E1C" BorderBrush="#1E3A5F" BorderThickness="1.5" Margin="10" CornerRadius="6">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 00 // HEADER -->
            <Border Grid.Row="0" BorderBrush="#1E2942" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,10" Background="Transparent" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Grid>
                    <TextBlock Text="PS2 HDD MOUNTER // PFS EXPLORER" FontFamily="ROG Fonts" FontSize="15" Foreground="#00F0FF" VerticalAlignment="Center" Effect="{StaticResource CyanGlow}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="[USB SAFETY // LOCKED]" FontFamily="Consolas" FontSize="11" Foreground="#00FF66" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="_" Width="28" Height="24" Background="#121B33" Foreground="#00F0FF" BorderBrush="#1E3A5F" Click="BtnMinimize_Click" Margin="0,0,5,0"/>
                        <Button Content="EXIT" Width="50" Height="24" Background="#1F0B12" Foreground="#FF3355" BorderBrush="#FF3355" Click="BtnExit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 01 // USB DRIVE SELECTIE -->
            <Border Grid.Row="1" Background="#0D1527" BorderBrush="#1E2942" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TARGET PS2 USB HDD //" VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="Consolas" Foreground="#00F0FF" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbDrives" Grid.Column="1" Style="{StaticResource SciFiComboBox}" Height="34" FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Caption}" Foreground="#00F0FF" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="SCAN USB" Style="{StaticResource SciFiButton}" Click="BtnRefreshDrives_Click" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- 02 // PARTITIE & ACTIES -->
            <Border Grid.Row="2" Background="#0D1527" BorderBrush="#1E2942" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="PARTITION //" VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="Consolas" Foreground="#CE00FF" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbPartition" Style="{StaticResource SciFiComboBox}" Width="180" Height="32" FontSize="13" SelectedIndex="0">
                            <ComboBoxItem Content="+OPL"/>
                            <ComboBoxItem Content="__.POPS"/>
                            <ComboBoxItem Content="__common"/>
                            <ComboBoxItem Content="__sysconf"/>
                            <ComboBoxItem Content="__boot"/>
                        </ComboBox>
                        <TextBlock Text="OR CUSTOM //" VerticalAlignment="Center" Margin="15,0,8,0" FontFamily="Consolas" Foreground="#8BB8E8"/>
                        <TextBox x:Name="txtCustomPartition" Width="160" Height="32" Background="#050A14" Foreground="#00F0FF" BorderBrush="#1E3A5F" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnListPartitions" Content="SCAN PARTITIONS" Style="{StaticResource SciFiButton}" BorderBrush="#CE00FF" Foreground="#CE00FF" Margin="0,0,8,0" Click="BtnListPartitions_Click"/>
                        <Button x:Name="BtnListFiles" Content="LIST FILES (LS)" Style="{StaticResource SciFiButton}" Margin="0,0,8,0" Click="BtnListFiles_Click"/>
                        <Button x:Name="BtnUploadFile" Content="UPLOAD FILE (PUT)" Style="{StaticResource SciFiButton}" BorderBrush="#00FF66" Foreground="#00FF66" Margin="0,0,8,0" Click="BtnUploadFile_Click"/>
                        <Button x:Name="BtnDownloadFile" Content="EXPORT FILE (GET)" Style="{StaticResource SciFiButton}" BorderBrush="#FF9900" Foreground="#FF9900" Click="BtnDownloadFile_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 03 // TERMINAL -->
            <TextBox Grid.Row="3" x:Name="txtLog" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                     Background="#050A14" Foreground="#00FF66" BorderBrush="#1E2942" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,0,0,10">
                <TextBox.Effect>
                    <DropShadowEffect/>
                </TextBox.Effect>
            </TextBox>

            <!-- 04 // STATUS -->
            <Grid Grid.Row="4">
                <TextBlock x:Name="txtStatus" Text="[STANDBY] Koppel je PS2 USB HDD en klik op SCAN USB." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                <ProgressBar x:Name="prgProgress" Width="200" Height="6" HorizontalAlignment="Right" Background="#050A14" BorderThickness="0" Foreground="#00F0FF" IsIndeterminate="True" Visibility="Collapsed"/>
            </Grid>
            <TextBlock HorizontalAlignment="Left" Margin="634,28,0,0" Grid.Row="4" TextWrapping="Wrap" Text="BUILD BY R3BU1LD 2026" VerticalAlignment="Top" Width="186" Height="28" Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF00D6FF" Direction="0" BlurRadius="24"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>

