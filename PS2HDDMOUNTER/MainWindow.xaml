<Window x:Class="PS2HDDMOUNTER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PS2HDDMOUNTER"
        mc:Ignorable="d"
       Title="PS2 HDD MOUNTER" Height="450" Width="600" Background="#F0F0F0" WindowStyle="None" ResizeMode="CanResizeWithGrip">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bovenbalk: Schijf selecteren -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Selecteer PS2 HDD (Physical Drive):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbDrives" Width="250" DisplayMemberPath="Caption"/>
            <Button Content="Vernieuw Lijst" Click="BtnRefreshDrives_Click" Margin="10,0,0,0" Padding="5,2"/>
        </StackPanel>

        <!-- Middendeel: Partitie en Acties -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Partitie (bijv. +OPL of __.POPS):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtPartition" Width="120" Text="+OPL" VerticalAlignment="Center" Padding="3"/>
            <Button Content="Toon Bestanden (ls)" Click="BtnListFiles_Click" Margin="10,0,0,0" Padding="8,4" Background="#E1E1E1"/>
            <Button Content="Bestand Uploaden (put)" Click="BtnUploadFile_Click" Margin="10,0,0,0" Padding="8,4" Background="#D1E7DD"/>
        </StackPanel>

        <!-- Logboek / Uitvoer venster -->
        <GroupBox Header="Output / Console Log" Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="txtLog" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" Background="Black" Foreground="LightGreen"/>
        </GroupBox>

        <!-- Statusbalk -->
        <TextBlock x:Name="txtStatus" Grid.Row="3" Text="Status: Standby. Start de applicatie als Administrator!" FontWeight="Bold" Foreground="DarkBlue"/>
    </Grid>
</Window>
